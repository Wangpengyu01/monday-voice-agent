[Unit]
Description=R1 local LLM daemon (Qwen3.5-4B on RK1828)
After=rknn3.service rknn-mdns.service network-online.target
Wants=rknn3.service network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=AGENT_ROOT=/userdata/agent
Environment=LLM_MODEL_DIR=/userdata/models/Qwen3.5-4B
Environment=LD_LIBRARY_PATH=/usr/lib
WorkingDirectory=/userdata/agent
ExecStartPre=/bin/mkdir -p /userdata/agent/logs /userdata/agent/run
ExecStartPre=/bin/bash /userdata/agent/scripts/wait_rknn.sh 45
ExecStartPre=/bin/rm -f /tmp/r1-llm.sock
# Qwen3.5-4B: official Rockchip RK1828 build (rknn3_models v1.1.0). Context 768, not 1024: with
# Qwen3-TTS also on the RK1828 a 1024 context does not fit (MODEL_SETUP fail). Previous model
# (InternVL3_5-4B) is still in /userdata/models for rollback.
ExecStart=/userdata/agent/bin/llm_daemon \
  /userdata/models/Qwen3.5-4B/Qwen3.5-4B.rknn \
  /userdata/models/Qwen3.5-4B/Qwen3.5-4B.weight \
  /userdata/models/Qwen3.5-4B/Qwen3.5-4B.tokenizer.gguf \
  /userdata/models/Qwen3.5-4B/Qwen3.5-4B.embed.bin \
  768 64 0xff
StandardOutput=append:/userdata/agent/logs/llm_daemon.log
StandardError=append:/userdata/agent/logs/llm_daemon.log
Restart=on-failure
RestartSec=10
TimeoutStartSec=360
ExecStartPost=/bin/bash /userdata/agent/scripts/fix_llm_sock_perms.sh /tmp/r1-llm.sock 300

[Install]
WantedBy=multi-user.target
