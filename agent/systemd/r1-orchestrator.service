[Unit]
Description=星期一 (M.O.N.D.A.Y.) 核心 (xiaolan_cli serve: WS API + 语音; WebUI 走同一 brain)
After=r1-vlm-daemon.service r1-llm-daemon.service r1-p4-eth.service network-online.target sound.target
Wants=r1-vlm-daemon.service r1-p4-eth.service network-online.target

[Service]
Type=simple
User=youyeetoo
Group=youyeetoo
SupplementaryGroups=audio
# teacher model key (DEEPSEEK_API_KEY=...), kept outside the deployed tree; optional
EnvironmentFile=-/userdata/secrets/deepseek.env
# device vault key (R1_VAULT_KEY=...), for operating devices with their stored accounts
EnvironmentFile=-/userdata/secrets/vault.env
Environment=AGENT_ROOT=/userdata/agent
Environment=PYTHONPATH=/userdata/agent
Environment=LD_LIBRARY_PATH=/userdata/voice/sherpa-onnx-v1.12.8-linux-aarch64-shared-cpu/lib
Environment=AGENT_MIC_CAPTURE_GAIN=8
# native crash (SIGSEGV) -> Python stacks of all threads in orchestrator.log
Environment=PYTHONFAULTHANDLER=1
WorkingDirectory=/userdata/agent
ExecStartPre=+/bin/bash /userdata/agent/scripts/fix_llm_sock_perms.sh /tmp/r1-llm.sock 90
ExecStartPre=/bin/bash /userdata/agent/scripts/orchestrator_wait_infer_sock.sh
ExecStartPre=-/bin/bash /userdata/voice/scripts/voice_hw_board.sh
ExecStartPre=-/bin/bash -c 'chown -R youyeetoo:youyeetoo /userdata/agent/ui 2>/dev/null; find /userdata/agent/run -maxdepth 1 -user root -exec chown youyeetoo:youyeetoo {} + 2>/dev/null; true'
ExecStart=/usr/bin/python3 -m orchestrator.main --config /userdata/agent/config/agent.yaml --agent-root /userdata/agent
StandardOutput=append:/userdata/agent/logs/orchestrator.log
StandardError=append:/userdata/agent/logs/orchestrator.log
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target